---
type Props = { section?: "posts" | "notes" };
const { section } = Astro.props;
const currentPath = section ? `/${section}` : Astro.url.pathname;
const links = [
  { href: "/posts", label: "Posts" },
  { href: "/notes", label: "Notes" },
  { href: "/lab", label: "Lab" },
  { href: "/about", label: "About" },
];
---

<a href="#main-content" class="skip-link">Skip to content</a>
<header class="app-layout site-header">
  <a href="/" class="site-name">Gal Elmalah</a>
  <nav aria-label="Main navigation">
    {
      links.map(({ href, label }) => (
        <a
          href={href}
          aria-current={currentPath.startsWith(href) ? "page" : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>

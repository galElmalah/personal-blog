---
import type { HTMLAttributes } from "astro/types";
import { SITE } from "@/config";

type Props = {
  noMarginTop?: boolean;
  compact?: boolean;
} & HTMLAttributes<"footer">;
const {
  noMarginTop = false,
  compact = false,
  class: className,
  ...attrs
} = Astro.props;
---

<footer
  class:list={[
    "app-layout site-footer",
    { "mt-auto": !noMarginTop, "home-footer": compact },
    className,
  ]}
  {...attrs}
>
  <span
    >Gal Elmalah <span aria-hidden="true">·</span>
    {new Date().getFullYear()}</span
  >
  <nav aria-label="Site utilities">
    <a href="/tags">Tags</a>
    {SITE.showArchives && <a href="/archives">Archive</a>}
    <a href="/search">Search</a>
    <a href="/rss.xml">RSS</a>
    {
      SITE.lightAndDarkMode && (
        <button
          id="theme-btn"
          title="Toggle light and dark mode"
          aria-label="Toggle light and dark mode"
        >
          Theme
        </button>
      )
    }
  </nav>
</footer>

---
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";

const entries = getSortedPosts(await getCollection("blog"));
const posts = entries.filter(({ data }) => data.type !== "thought").slice(0, 2);
const notes = entries.filter(({ data }) => data.type === "thought").slice(0, 2);
---

<Layout>
  <main id="main-content" class="home-intro app-layout" data-layout="index">
    <h1>Hi, I’m <span class="serif-accent">Gal.</span></h1>
    <p>
      I write about engineering, systems, leadership, and the work behind the
      work. Practical lessons from building and shipping software.
    </p>
    <p>
      Longer pieces live in <a href="/posts">posts</a>. Smaller ideas go into
      <a href="/notes">notes</a>. Side projects and experiments end up in the
      <a href="/lab">lab</a>. And here’s a little more <a href="/about"
        >about me</a
      >.
    </p>
    <p>
      You can find my code on <a href="https://github.com/galelmalah">GitHub</a
      >, follow along on <a href="https://twitter.com/galelmalah">X</a>, or
      connect on
      <a href="https://www.linkedin.com/in/gal-elmalah-71874115a/">LinkedIn</a>.
    </p>
    <section class="desk" aria-labelledby="desk-heading">
      <h2 id="desk-heading" class="eyebrow">On the desk</h2>
      <div class="desk-grid">
        <section aria-labelledby="desk-posts">
          <h3 id="desk-posts">
            <a href="/posts">Posts <span aria-hidden="true">↗</span></a>
          </h3>
          <ul>
            {
              posts.map((post) => (
                <li>
                  <a href={getPath(post.id, post.filePath)}>
                    {post.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
        <section aria-labelledby="desk-notes">
          <h3 id="desk-notes">
            <a href="/notes">Notes <span aria-hidden="true">↗</span></a>
          </h3>
          <ul>
            {
              notes.map((note) => (
                <li>
                  <a href={`/notes#${note.id}`}>{note.data.title}</a>
                </li>
              ))
            }
          </ul>
        </section>
        <section aria-labelledby="desk-lab">
          <h3 id="desk-lab">
            <a href="/lab">Lab <span aria-hidden="true">↗</span></a>
          </h3>
          <ul>
            <li>
              <a href="https://orbit.galelmalah.dev">Read in Orbit</a><span
                class="desk-caption">A little universe for your books.</span
              >
            </li>
          </ul>
        </section>
      </div>
    </section>
  </main>
  <Footer compact />
</Layout>

<script>
  if (document.querySelector('[data-layout="index"]')) {
    sessionStorage.setItem("backUrl", "/");
  }
</script>
